{
  "name": "space-client-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/website", "apps/api"],
  "engines": { "node": ">=22" },
  "scripts": {
    "site": "npm run dev --workspace @space/website",
    "api": "npm run dev --workspace @space/api",
    "build": "npm run build --workspace @space/api && npm run build --workspace @space/website",
    "test": "node --test tests/*.test.cjs && npm run test --workspace @space/api",
    "check": "npm run check --workspaces"
  }
}
